{
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "dist/public",
    "functions": {
        "api/[...path].ts": {
            "includeFiles": "dist/index.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/[...path].ts"
        },
        {
            "source": "/((?!.*\\.(png|jpg|jpeg|gif|svg|ico|css|js|woff|woff2|ttf|eot|json|webp|mp4|webm)).*)",
            "destination": "/index.html"
        }
    ]
}
