# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env.production and fill in your production values.
# These same values should also be configured in:
#   1. Vercel Dashboard: Project Settings > Environment Variables
#   2. GitHub Secrets: Repository Settings > Secrets and variables > Actions
# =============================================================================

# -----------------------------------------------------------------------------
# STRIPE CONFIGURATION
# Get these from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Get these from: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/public key (starts with "eyJ...")
VITE_SUPABASE_ANON_KEY=eyJ...your_supabase_anon_key_here
# The service role key for server-side operations (starts with "eyJ...")
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Set to 'true' to force using in-memory storage instead of Supabase
# (useful for testing production builds locally)
USE_MOCK_DATABASE=false

# -----------------------------------------------------------------------------
# VERCEL CONFIGURATION (for GitHub Actions deployment)
# Get these from: https://vercel.com/account/tokens
# and Project Settings > General
# -----------------------------------------------------------------------------
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_vercel_org_id
# VERCEL_PROJECT_ID=your_vercel_project_id

# =============================================================================
# GITHUB SECRETS CHECKLIST
# =============================================================================
# Add these secrets to your GitHub repository:
# Repository > Settings > Secrets and variables > Actions > New repository secret
#
# Required secrets:
#   - SUPABASE_URL
#   - SUPABASE_SERVICE_ROLE_KEY
#   - VITE_SUPABASE_ANON_KEY
#   - STRIPE_SECRET_KEY
#   - STRIPE_WEBHOOK_SECRET
#   - VITE_STRIPE_PUBLIC_KEY
#   - VERCEL_TOKEN
#   - VERCEL_ORG_ID
#   - VERCEL_PROJECT_ID
# =============================================================================
